<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>G-PC-Health-Check</AssemblyName>
    <RootNamespace>G.PcHealthCheck</RootNamespace>
    <GeneratedBrandDir>$(MSBuildProjectDirectory)\obj\brand</GeneratedBrandDir>
    <ApplicationIcon>$(GeneratedBrandDir)\gpchc.ico</ApplicationIcon>
    <Version>0.7.0</Version>
    <FileVersion>0.7.0.0</FileVersion>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <Product>G PC Health Check</Product>
    <Company>G</Company>
    <Description>Service Desk workstation diagnostics and controlled remediation for Windows 11.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <Target Name="GenerateBrandAssets" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File tools\branding\Generate-BrandAssets.ps1 -OutputDirectory &quot;$(GeneratedBrandDir)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\..\.." />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="$(GeneratedBrandDir)\g-shield.png" LogicalName="G.PcHealthCheck.g-shield.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>
</Project>
